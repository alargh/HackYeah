# Copy to .env and fill in. Never commit .env.

# Required: Gemini API key (Google AI Studio). GOOGLE_API_KEY is accepted as a fallback.
GEMINI_API_KEY=
# GOOGLE_API_KEY=

# Runtime model used for all mathematical reasoning and content generation.
GEMINI_MODEL=gemini-3.5-flash

# Voiceover (Azure or local). Set VOICEOVER=false for silent videos.
VOICEOVER=true
# local (default): Chatterbox service with Piper as backup | piper: offline Piper only
TTS_PROVIDER=azure
# azure: Azure AI Speech neural voices (free tier F0: 0.5 M characters/month), then local, then Piper
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=swedencentral
# Polish: pl-PL-AgnieszkaNeural | pl-PL-MarekNeural | pl-PL-ZofiaNeural
# AZURE_TTS_VOICES=pl:pl-PL-MarekNeural,en:en-US-AndrewMultilingualNeural
# Speaking rate for a calm tutor pace
# AZURE_TTS_RATE=-4%
# CPU threads for the local voice
TTS_THREADS=8

# Render automatically after generation (true/false).
AUTO_RENDER=true
# Manim quality: l (480p, fast) | m (720p) | h (1080p)
MANIM_QUALITY=l
# Per-scene render timeout in seconds.
RENDER_TIMEOUT_S=240
LOG_LEVEL=INFO

# Parallelism inside one lesson: every scene is generated at once and renders as soon as it is ready
# SCENE_WORKERS=12
# RENDER_WORKERS=8
# Visual planning: a Gemini call thinking longer than this is cancelled; retries run N candidates in parallel
# VISUAL_PLAN_TIMEOUT_S=75
# VISUAL_PLAN_PARALLEL_RETRIES=2
